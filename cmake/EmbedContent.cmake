set(generated "// Generated by cmake/EmbedContent.cmake from core/content. Do not edit.\n")
string(APPEND generated "// clang-format off\n\n")
string(APPEND generated "#include <cstddef>\n#include <string_view>\n\n")
string(APPEND generated "namespace softphone::core::content {\nnamespace {\n\n")

list(LENGTH FILES count)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    list(GET FILES ${index} file)
    file(READ "${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
    string(APPEND generated "const unsigned char kContent${index}[] = {\n    ${bytes}\n};\n\n")
endforeach()

string(APPEND generated "struct Entry {\n")
string(APPEND generated "    std::string_view language;\n")
string(APPEND generated "    const unsigned char *bytes;\n")
string(APPEND generated "    std::size_t size;\n};\n\n")
string(APPEND generated "const Entry kEntries[] = {\n")
foreach(index RANGE ${last})
    list(GET NAMES ${index} name)
    string(APPEND generated
           "    {\"${name}\", kContent${index}, sizeof kContent${index}},\n")
endforeach()
string(APPEND generated "};\n\n} // namespace\n\n")

string(APPEND generated "std::string_view shippedBytes(std::string_view language) noexcept\n{\n")
string(APPEND generated "    for (const auto &entry : kEntries) {\n")
string(APPEND generated "        if (entry.language == language) {\n")
string(APPEND generated
       "            return {reinterpret_cast<const char *>(entry.bytes), entry.size};\n")
string(APPEND generated "        }\n    }\n    return {};\n}\n\n")
string(APPEND generated "} // namespace softphone::core::content\n")

if(EXISTS "${OUT}")
    file(READ "${OUT}" existing)
    if(existing STREQUAL generated)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${generated}")
