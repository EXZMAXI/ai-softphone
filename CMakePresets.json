{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development build"
    },
    {
      "name": "package",
      "inherits": "base",
      "displayName": "Release build laid out for a package",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SOFTPHONE_PACKAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "package",
      "configurePreset": "package"
    }
  ]
}
